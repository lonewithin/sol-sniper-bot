BOT_TOKEN=            # from @BotFather
OWNER_ID=             # your numeric Telegram ID (ask @userinfobot)
RPC_URL=https://api.mainnet-beta.solana.com   # free Helius key URL recommended
# Optional: import an existing burner. If empty, bot generates its own encrypted burner.
BURNER_PRIVATE_KEY=
# Optional: passphrase for wallet encryption. If empty, a random one is stored in data/wallet.pass (chmod 600)
WALLET_ENC_KEY=
PAPER=true
